<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.7</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net472</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <RimWorldInstallDir Condition="'$(RimWorldInstallDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/RimWorld</RimWorldInstallDir>
    <AssemblyName>VirtualHerds</AssemblyName>
    <RootNamespace>VirtualHerds</RootNamespace>
    <OutputPath>$(ProjectDir)..\..\$(RimWorldVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" Condition="'$(RimWorldVersion)' == '1.6'" />
    <Reference Include="Assembly-CSharp" Condition="'$(RimWorldVersion)' == '1.7'">
      <HintPath>$(RimWorldInstallDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs" Condition="'$(RimWorldVersion)' == '1.7'">
      <HintPath>$(RimWorldInstallDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Lib.Harmony" Version="2.3.6">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="ValidateRimWorldVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RimWorldVersion)' != '1.6' and '$(RimWorldVersion)' != '1.7'" Text="RimWorldVersion must be 1.6 or 1.7." />
    <Error Condition="'$(RimWorldVersion)' == '1.7' and !Exists('$(RimWorldInstallDir)/Assembly-CSharp.dll')" Text="Set RimWorldInstallDir to a RimWorld 1.7 installation containing Assembly-CSharp.dll." />
  </Target>
</Project>
