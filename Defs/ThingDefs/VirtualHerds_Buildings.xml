<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>VirtualHerds_Barn</defName>
    <label>virtual herd barn</label>
    <description>A basic unpowered barn that stores eligible player-owned livestock as map-wide virtual herds. Intake deliberately normalizes individual identity and state; inspect the barn for the warning and controls.</description>
    <thingClass>VirtualHerds.Building_VirtualBarn</thingClass>
    <graphicData>
      <texPath>Things/Building/VirtualHerds_Barn</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.35</fillPercent>
    <tickerType>Normal</tickerType>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <WorkToMake>2000</WorkToMake>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.8</Flammability>
    </statBases>
    <costStuffCount>160</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <!-- Retained at its original size for existing saves. -->
    <placeWorkers><li>VirtualHerds.PlaceWorker_VirtualBarn</li></placeWorkers>
    <modExtensions><li Class="VirtualHerds.BarnTierExtension"><tier>0</tier><nextBarnDefName>VirtualHerds_PastureBarn</nextBarnDefName></li></modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>VirtualHerds_PastureBarn</defName>
    <label>pasture barn</label>
    <description>A neolithic facility for intensive livestock management. Herds are pooled across this map; the most advanced barn controls all boost limits and operating power costs. Use the upgrade command to rebuild in place without releasing animals. Every upgrade requires the full new facility's resources and construction work.</description>
    <thingClass>VirtualHerds.Building_VirtualBarn</thingClass>
    <graphicData><texPath>Things/Building/HerdBarn_0</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(4,4)</drawSize></graphicData>
    <size>(4,4)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability><pathCost>50</pathCost><fillPercent>0.5</fillPercent>
    <tickerType>Normal</tickerType><useHitPoints>true</useHitPoints>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <statBases><WorkToMake>4000</WorkToMake><MaxHitPoints>300</MaxHitPoints><Flammability>0.6</Flammability></statBases>
    <costList><WoodLog>350</WoodLog><BlocksGranite>150</BlocksGranite></costList>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites><li>VirtualHerds_Pastoralism</li></researchPrerequisites>
    <placeWorkers><li>VirtualHerds.PlaceWorker_VirtualBarn</li></placeWorkers>
    <modExtensions><li Class="VirtualHerds.BarnTierExtension"><tier>0</tier><nextBarnDefName>VirtualHerds_ManagedBarn</nextBarnDefName></li></modExtensions>

  </ThingDef>
